{
  "name": "mockhall",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Free, no-login, mobile-first mock tests for SBI Clerk and IBPS Clerk prelims.",
  "scripts": {
    "dev": "vite",
    "banks": "tsx scripts/build-banks.ts",
    "build:puzzles": "tsx scripts/build-puzzles.ts",
    "build": "npm run banks && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "test": "vitest run tests/unit",
    "test:prop": "vitest run tests/property",
    "test:content": "vitest run tests/content",
    "test:all": "vitest run",
    "qa": "tsx scripts/content-qa.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "idb-keyval": "^6.3.0",
    "katex": "^0.18.7",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "an-array-of-english-words": "^2.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "workbox-window": "^7.4.1"
  }
}
